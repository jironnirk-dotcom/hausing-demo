<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Hausing — Amsterdam Property</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
</head>
<body>
<header class="nav">
  <div class="logo">HAUSING<span>.</span></div>
  <nav><a href="#properties">Properties</a><a href="#services">Services</a><a href="#about">About</a></nav>
  <a class="navbtn" href="#contact">Find a home</a>
</header>

<main>
<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">AMSTERDAM · BUY · RENT · SELL</p>
    <h1>Find a place<br><em>to call home.</em></h1>
    <p class="lead">A modern Amsterdam property experience for people who want clear advice, beautiful homes and a smooth move.</p>
    <div class="actions"><a class="primary" href="#properties">Explore properties</a><a class="secondary" href="#contact">Talk to an agent →</a></div>
  </div>
  <div class="hero-card">
    <div class="hero-image"></div>
    <div class="property-caption"><div><b>Canal House</b><span>Jordaan · Amsterdam</span></div><strong>€895,000</strong></div>
  </div>
</section>

<section class="trust"><span>LOCAL KNOWLEDGE</span><span>PERSONAL SERVICE</span><span>AMSTERDAM SPECIALISTS</span><span>EXPAT FRIENDLY</span></section>

<section id="properties" class="section">
  <div class="section-head"><div><p class="eyebrow">FEATURED</p><h2>Homes worth seeing.</h2></div><a href="#">View all →</a></div>
  <div class="grid">
    <article class="property"><div class="photo p1"></div><div class="meta"><div><h3>Light-filled canal apartment</h3><p>De Pijp · 3 rooms</p></div><b>€625,000</b></div></article>
    <article class="property"><div class="photo p2"></div><div class="meta"><div><h3>Quiet family townhouse</h3><p>Amsterdam Noord · 5 rooms</p></div><b>€780,000</b></div></article>
    <article class="property"><div class="photo p3"></div><div class="meta"><div><h3>Classic city apartment</h3><p>Oud-West · 2 rooms</p></div><b>€495,000</b></div></article>
  </div>
</section>

<section id="services" class="services">
  <div><p class="eyebrow">WHAT WE DO</p><h2>Property advice without the headache.</h2></div>
  <div class="service-list">
    <div><span>01</span><div><h3>Buying</h3><p>Get help finding the right property and making confident decisions.</p></div></div>
    <div><span>02</span><div><h3>Selling</h3><p>Present your home beautifully and reach the right buyers.</p></div></div>
    <div><span>03</span><div><h3>Renting</h3><p>Move through the Amsterdam rental market with a clear process.</p></div></div>
  </div>
</section>

<section id="about" class="about"><div class="about-image"></div><div><p class="eyebrow">AMSTERDAM, MADE SIMPLE</p><h2>Local people. Personal advice.</h2><p>Buying or renting in Amsterdam can move fast. This concept puts the most important information first, makes properties easy to explore and gives visitors a clear next step.</p><a class="secondary" href="#contact">Meet the team →</a></div></section>

<section id="contact" class="contact"><p class="eyebrow">LET'S TALK</p><h2>Looking for your next move?</h2><p>Tell us what you're looking for and we'll get back to you.</p><form onsubmit="event.preventDefault();document.querySelector('#thanks').hidden=false"><input required placeholder="Your name"><input required type="email" placeholder="Email address"><select><option>I'm looking to buy</option><option>I'm looking to rent</option><option>I want to sell</option></select><button>Send enquiry</button></form><p id="thanks" hidden>Thanks — this is a demo enquiry form.</p></section>
</main>
<footer><div class="logo">HAUSING<span>.</span></div><p>Demo redesign concept by JD Digital. Not the official Hausing website.</p></footer>
<script src="script.js"></script>
</body>
</html>
document.querySelectorAll('a[href^="#"]').forEach(a=>a.addEventListener('click',e=>{const el=document.querySelector(a.getAttribute('href'));if(el){e.preventDefault();el.scrollIntoView({behavior:'smooth'})}}));
